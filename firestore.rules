rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Helpers
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 2 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'champ5698@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidLot(data, lotId) {
      return data.keys().hasAll([
          'id', 'shortLabel', 'sourceLocation', 'startDate',
          'endDate', 'bidOpeningAt', 'description', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'shortLabel', 'sourceLocation', 'startDate',
          'endDate', 'bidOpeningAt', 'description', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == lotId && isValidId(data.id)
        && data.shortLabel is string && data.shortLabel.size() >= 2 && data.shortLabel.size() <= 120
        && data.sourceLocation is string && data.sourceLocation.size() >= 2 && data.sourceLocation.size() <= 160
        && data.startDate is string && data.startDate.size() >= 2 && data.startDate.size() <= 60
        && data.endDate is string && data.endDate.size() >= 2 && data.endDate.size() <= 60
        && data.bidOpeningAt is string && data.bidOpeningAt.size() >= 2 && data.bidOpeningAt.size() <= 60
        && data.description is string && data.description.size() >= 2 && data.description.size() <= 1000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTransformerUnit(data, transformerId) {
      return data.keys().hasAll([
          'id', 'lotId', 'lotCode', 'peaNo', 'kva',
          'stockQty', 'summaryNote', 'imageUrls', 'imageCaptions', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'lotId', 'lotCode', 'peaNo', 'kva',
          'stockQty', 'summaryNote', 'imageUrls', 'imageCaptions', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == transformerId && isValidId(data.id)
        && data.lotId is string && isValidId(data.lotId)
        && data.lotCode is string && data.lotCode.size() >= 2 && data.lotCode.size() <= 80
        && data.peaNo is string && data.peaNo.size() == 11 && data.peaNo.matches('^TR[0-9]{2}-[0-9]{6}$')
        && data.kva is number && data.kva >= 1 && data.kva <= 100000
        && data.stockQty is number && data.stockQty >= 0 && data.stockQty <= 1000
        && data.summaryNote is string && data.summaryNote.size() >= 2 && data.summaryNote.size() <= 1000
        && data.imageUrls is list && data.imageUrls.size() == 3
        && data.imageUrls[0] is string && data.imageUrls[0].size() <= 280000
        && data.imageUrls[1] is string && data.imageUrls[1].size() <= 280000
        && data.imageUrls[2] is string && data.imageUrls[2].size() <= 280000
        && data.imageCaptions is list && data.imageCaptions.size() == 3
        && data.imageCaptions[0] is string && data.imageCaptions[0].size() <= 200
        && data.imageCaptions[1] is string && data.imageCaptions[1].size() <= 200
        && data.imageCaptions[2] is string && data.imageCaptions[2].size() <= 200
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['email', 'createdAt'])
        && data.keys().hasOnly(['email', 'createdAt'])
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 160
        && data.createdAt is timestamp;
    }

    function isValidCatalogMeta(data) {
      return data.keys().hasAll(['initialized', 'updatedAt'])
        && data.keys().hasOnly(['initialized', 'updatedAt'])
        && data.initialized is bool
        && data.updatedAt is timestamp;
    }

    // Public Read-Only Catalog: Lots (Admin Write Only)
    match /lots/{lotId} {
      allow get: if isValidId(lotId);
      allow list: if true;
      allow create: if isAdmin()
        && isValidId(lotId)
        && isValidLot(incoming(), lotId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(lotId)
        && isValidLot(incoming(), lotId)
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'shortLabel', 'sourceLocation', 'startDate', 'endDate',
          'bidOpeningAt', 'description', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(lotId);
    }

    // Public Read-Only Catalog: Used/Damaged Transformers (Admin Write Only)
    match /transformers/{transformerId} {
      allow get: if isValidId(transformerId);
      allow list: if true;
      allow create: if isAdmin()
        && isValidId(transformerId)
        && isValidTransformerUnit(incoming(), transformerId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/lots/$(incoming().lotId));
      allow update: if isAdmin()
        && isValidId(transformerId)
        && isValidTransformerUnit(incoming(), transformerId)
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/lots/$(incoming().lotId))
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'lotId', 'lotCode', 'peaNo', 'kva',
          'stockQty', 'summaryNote', 'imageUrls', 'imageCaptions', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(transformerId);
    }

    // Catalog Initialization Flag
    match /catalogMeta/{metaId} {
      allow get: if isValidId(metaId);
      allow list: if true;
      allow create: if isAdmin()
        && isValidId(metaId)
        && isValidCatalogMeta(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(metaId)
        && isValidCatalogMeta(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['initialized', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(metaId);
    }

    // Admin Registry
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && isVerifiedUser() && (request.auth.uid == adminUid || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin()
        && isValidId(adminUid)
        && isValidAdminUser(incoming())
        && incoming().createdAt == request.time;
      allow update: if isAdmin()
        && isValidId(adminUid)
        && isValidAdminUser(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['email']);
      allow delete: if isAdmin() && isValidId(adminUid);
    }
  }
}
