{
  "entities": {
    "TransformerLot": {
      "title": "TransformerLot",
      "description": "A lot/batch of used or damaged transformers listed for sale at PEA Fang (กฟส.ฝาง).",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 2,
          "maxLength": 64
        },
        "shortLabel": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "sourceLocation": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "startDate": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "endDate": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "bidOpeningAt": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "description": {
          "type": "string",
          "minLength": 2,
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "shortLabel",
        "sourceLocation",
        "startDate",
        "endDate",
        "bidOpeningAt",
        "description",
        "createdAt",
        "updatedAt"
      ]
    },
    "TransformerUnit": {
      "title": "TransformerUnit",
      "description": "An individual used/damaged electrical transformer unit inside a lot.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 2,
          "maxLength": 64
        },
        "lotId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 2,
          "maxLength": 64
        },
        "lotCode": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "peaNo": {
          "type": "string",
          "pattern": "^TR[0-9]{2}-[0-9]{6}$",
          "minLength": 11,
          "maxLength": 11
        },
        "kva": {
          "type": "number"
        },
        "phase": {
          "type": "string",
          "enum": ["1 เฟส", "3 เฟส"]
        },
        "stockQty": {
          "type": "number"
        },
        "summaryNote": {
          "type": "string",
          "minLength": 2,
          "maxLength": 1000
        },
        "imageUrls": {
          "type": "array"
        },
        "imageCaptions": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "lotId",
        "lotCode",
        "peaNo",
        "kva",
        "phase",
        "stockQty",
        "summaryNote",
        "imageUrls",
        "imageCaptions",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Marker document granting catalog management privileges to an admin UID.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "minLength": 5,
          "maxLength": 160
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["email", "createdAt"]
    },
    "CatalogMeta": {
      "title": "CatalogMeta",
      "description": "Tracks whether the live Firestore catalog has been initialized.",
      "type": "object",
      "properties": {
        "initialized": {
          "type": "boolean"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["initialized", "updatedAt"]
    }
  },
  "firestore": {
    "/lots/{lotId}": {
      "schema": { "$ref": "#/entities/TransformerLot" },
      "description": "Publicly readable used/damaged transformer lots at PEA Fang, writable only by verified admins."
    },
    "/transformers/{transformerId}": {
      "schema": { "$ref": "#/entities/TransformerUnit" },
      "description": "Publicly readable used/damaged transformer units, writable only by verified admins."
    },
    "/catalogMeta/{metaId}": {
      "schema": { "$ref": "#/entities/CatalogMeta" },
      "description": "Publicly readable catalog initialization flag, writable only by verified admins."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Admin authorization registry."
    }
  }
}
